# Backend reads the repository root .env; process environment takes precedence.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-west-2
# deny-all requires an Archil plan supporting custom network policies.
# managed permits the provider's Free-plan allowlist, verified by getNetwork().
ARCHIL_NETWORK_MODE=deny-all
PORT=4310
# Uses the host's existing codex login (ChatGPT subscription), never copied tokens.
CODEX_MODEL=gpt-6.1-sol
# Optional: reuse a known company disk; otherwise metadata is retained locally.
ARCHIL_COMPANY_DISK_ID=
