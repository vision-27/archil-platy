{
  "name": "platypus-workflow-lab-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "rehearse:company": "node scripts/rehearse-company.mjs",
    "preview:check": "node scripts/preview-check.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "reset:company": "node scripts/reset-company.mjs --archive"
  },
  "dependencies": {
    "disk": "1.12.1"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
